{
  "rules": {
    ".read": false,
    ".write": false,
    "measurements": {
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren(['point', 'spacing']) && newData.child('spacing').isNumber()"
      }
    },
    "water": {
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren(['point'])"
      }
    }
  }
}
